// Recursos do Jogar.exe: ícone, manifesto e informação de versão.
#include <winver.h>

1 ICON "icon.ico"
1 24 "jogar.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "081604b0"
    BEGIN
      VALUE "CompanyName", "Pitch Invaders"
      VALUE "FileDescription", "Pitch Invaders"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Jogar"
      VALUE "LegalCopyright", "MIT"
      VALUE "OriginalFilename", "Jogar.exe"
      VALUE "ProductName", "Pitch Invaders"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0816, 1200
  END
END
